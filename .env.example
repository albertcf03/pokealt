# Opcional: la web ya usa el proyecto de Supabase de src/config.js.
# Solo si quieres apuntar a otro proyecto, copia este archivo como .env y quita el # de las dos líneas:
# VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Nunca pongas aquí la "secret key" ni la "service_role key": esas no van en la web.
